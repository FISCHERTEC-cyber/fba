generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoucherKind {
  VALUE
  DISCOUNT
  SERVICE
  CASHBACK
  STORE_CREDIT
  LOYALTY
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  ARCHIVED
}

enum SourceType {
  PHOTO
  PDF
  SCREENSHOT
  EMAIL
  MANUAL
  WALLET
}

enum NotificationKind {
  EXPIRY
  OPPORTUNITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ImportCandidateStatus {
  PENDING
  IMPORTED
  DISMISSED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  vouchers        Voucher[]
  merchantSources MerchantSource[]
  notifications   Notification[]
  importCandidates VoucherImportCandidate[]
  createdAt       DateTime         @default(now())
}

model VoucherImportCandidate {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerMessageId String
  sender            String
  recipient         String
  subject           String
  receivedAt        DateTime
  analysis          Json
  reviewRequired    Boolean               @default(true)
  status            ImportCandidateStatus @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([userId, providerMessageId])
  @@index([userId, status, receivedAt])
}

model Voucher {
  id                      String               @id @default(cuid())
  userId                  String
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantName            String
  merchantUrl             String?
  title                   String
  kind                    VoucherKind
  valueAmount             Decimal?             @db.Decimal(12, 2)
  currency                String?              @default("EUR")
  discountPercent         Decimal?             @db.Decimal(5, 2)
  code                    String?
  barcode                 String?
  qrPayload               String?
  validFrom               DateTime?
  validUntil              DateTime?
  minimumOrderValue       Decimal?             @db.Decimal(12, 2)
  redemptionUrl           String?
  terms                   String?
  physicalVoucher         Boolean              @default(false)
  storageLocation         String?
  storageLocationPhotoUrl String?
  lastLocationUpdate      DateTime?
  status                  VoucherStatus        @default(ACTIVE)
  eventMonitoringEnabled  Boolean              @default(false)
  extractionConfidence    Float?
  sourceType              SourceType           @default(MANUAL)
  sourceReference         String?
  opportunities           Opportunity[]
  transactions            VoucherTransaction[]
  notifications           Notification[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model VoucherTransaction {
  id         String   @id @default(cuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amount     Decimal? @db.Decimal(12, 2)
  note       String?
  receiptUrl String?
  createdAt  DateTime @default(now())
}

model Opportunity {
  id              String    @id @default(cuid())
  voucherId       String
  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  title           String
  startsAt        DateTime?
  endsAt          DateTime?
  sourceUrl       String?
  sourceCheckedAt DateTime?
  distanceKm      Float?
  relevanceScore  Int       @default(0)
  reasonJson      Json?
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model MerchantSource {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantName       String
  url                String
  enabled            Boolean         @default(true)
  checkIntervalHours Int             @default(24)
  lastCheckedAt      DateTime?
  lastSuccessAt      DateTime?
  nextCheckAt        DateTime        @default(now())
  etag               String?
  lastModified       String?
  contentHash        String?
  failureCount       Int             @default(0)
  lastError          String?
  events             MerchantEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, url])
  @@index([userId, enabled])
  @@index([enabled, nextCheckAt])
}

model MerchantEvent {
  id              String         @id @default(cuid())
  sourceId        String
  source          MerchantSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalKey     String
  merchantName    String
  title           String
  description     String?
  startsAt        DateTime?
  endsAt          DateTime?
  sourceUrl       String?
  sourceLabel     String?
  categories      String[]
  fingerprint     String
  active          Boolean        @default(true)
  missingCount    Int            @default(0)
  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  lastChangedAt   DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]

  @@unique([sourceId, externalKey])
  @@index([sourceId, active])
  @@index([endsAt])
}

model Notification {
  id                  String                        @id @default(cuid())
  userId              String
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId           String?
  voucher             Voucher?                      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  merchantEventId     String?
  merchantEvent       MerchantEvent?                @relation(fields: [merchantEventId], references: [id], onDelete: Cascade)
  kind                NotificationKind
  channel             NotificationChannel           @default(IN_APP)
  deliveryStatus      NotificationDeliveryStatus    @default(DELIVERED)
  dedupeKey           String                        @unique
  title               String
  body                String
  payload             Json?
  recipient           String?
  attemptCount        Int                           @default(0)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  lastError           String?
  providerMessageId   String?
  deliveredAt         DateTime?
  readAt              DateTime?
  dismissedAt         DateTime?
  deliveryAttempts    NotificationDeliveryAttempt[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([userId, dismissedAt, readAt])
  @@index([deliveryStatus, createdAt])
  @@index([channel, deliveryStatus, nextAttemptAt])
}

model NotificationDeliveryAttempt {
  id                String       @id @default(cuid())
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  successful        Boolean
  providerMessageId String?
  error             String?
  createdAt         DateTime     @default(now())

  @@unique([notificationId, attemptNumber])
  @@index([createdAt])
}
